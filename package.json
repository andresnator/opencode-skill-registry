{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-skill-registry",
  "version": "0.1.0",
  "description": "OpenCode plugin that generates a lightweight per-project index of skills and convention files.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bash scripts/test-skill-registry.sh",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "opencode": ">=1.17.15 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.13",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresnator/opencode-skill-registry.git"
  },
  "bugs": {
    "url": "https://github.com/andresnator/opencode-skill-registry/issues"
  },
  "homepage": "https://github.com/andresnator/opencode-skill-registry#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "registry",
    "agents"
  ]
}
